{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@leadpilot/core": ["../core/src/index.ts"],
      "@leadpilot/scoring": ["../scoring/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
